  "narrative": {
    "northStar": "Broadcast Listings",
    "overview": "Your library is your own broadcast schedule. Screens read like an evening's TV listings: what's on next, then the week set in a listings-column rhythm. The system refuses the streaming-service banner-and-rows wall; the user's cover art and banners are the only imagery, and the chrome recedes into a dark graphite scene built for evening, lean-back use.",
    "keyCharacteristics": ["Fixed graphite tonal ramp; no ad-hoc greys.", "Each accent colour does exactly one job.", "Newsprint rules: 2px under section heads, 1px between columns.", "Boxed glyph marks (NEW, FINAL), at most one per item.", "Artwork leads; chrome is flat and quiet."],
    "rules": [
      { "name": "The One Job Rule", "body": "Each accent colour means one thing. Red is NEW/now/progress/primary action; amber is FINAL/warning; teal is synced. Never use an accent for decoration.", "section": "colors" },
      { "name": "The Fixed Ramp Rule", "body": "Neutrals come only from the ramp (Ink Black → Newsprint White). Never introduce an ad-hoc grey.", "section": "colors" },
      { "name": "The Tabular Numbers Rule", "body": "Episode numbers, counts, times and dates use tabular numerals.", "section": "typography" },
      { "name": "The Flat-By-Default Rule", "body": "Surfaces are flat at rest; shadows only lift artwork over artwork.", "section": "elevation" }
    ],
    "dos": ["Do keep every neutral on the graphite ramp.", "Do set section heads in uppercase Archivo Narrow over a 2px Newsprint White rule.", "Do let cover art and banners be the only imagery; fall back to the show's AniList colour.", "Do show status with its evidence (time since sync, files matched)."],
    "donts": ["Don't build a streaming-service banner-and-rows wall.", "Don't use an accent colour for decoration or give an item more than one mark.", "Don't add shadows to flat surfaces."]
