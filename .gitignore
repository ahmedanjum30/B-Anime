# Rust
/target/

# Installers
/dist/

# Frontend
node_modules/
/app/dist/

# Tauri generated (schemas are rebuilt every build). The Android project under gen/android is
# kept: it holds the icon, signing setup, permissions and Gradle settings. Its own .gitignore
# leaves out build output and keystore.properties.
/app/src-tauri/gen/*
!/app/src-tauri/gen/android/

# Impeccable: machine-local and review captures
/.impeccable/config.local.json
/.impeccable/review/
/.impeccable/live/

# Claude Code local settings
/.claude/settings.local.json

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/settings.json
